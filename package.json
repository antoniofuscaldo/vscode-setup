{
  "name": "vscode-setup",
  "version": "1.0.0",
  "description": "A highly opinionated, aesthetic, and productivity-focused configuration for Visual Studio Code.",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "clean:all": "npm run clean:dist && npm run clean:node_modules",
    "clean:dist": "rimraf dist",
    "clean:node_modules": "rimraf node_modules",
    "format": "prettier --write 'src/.vscode/**/*.json' 'src/.vscode/*.code-snippets' '*.md'",
    "format:check": "prettier --check 'src/.vscode/**/*.json' 'src/.vscode/*.code-snippets' '*.md'",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3"
  },
  "lint-staged": {
    "src/.vscode/*.json": [
      "prettier --write --parser json"
    ],
    "src/.vscode/*.code-snippets": [
      "prettier --write --parser json"
    ],
    "*.md": [
      "prettier --write --parser markdown"
    ]
  }
}
